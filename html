  ${alarmOn()?`<div class="alert" style="margin-top:10px"><p>${state.prof.age!=='adulto'?'Esta ferramenta calcula doses para adultos. Fala com um profissional de saúde.':'Há sinais de alarme assinalados. Não uses plantas para isto sem falar com um médico. Em urgência, liga 112 ou SNS 24 (808 24 24 24).'}</p></div>`
   :`<div style="margin-top:10px"><button class="btn" data-a="ok">${state.ok?'Perfil confirmado':'Confirmar perfil'}</button></div>`}
  </section>`;
}
