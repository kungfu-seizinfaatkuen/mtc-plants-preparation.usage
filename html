<!DOCTYPE html>
<html lang="pt-PT">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Oficina de Fórmulas</title>
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#1e3226">
<style>
:root{--ink:#14201a;--paper:#f3f2ea;--card:#fff;--line:#d8dbcd;--moss:#1e3226;--saf:#ffb703;--blue:#2f6fde;--green:#1fa35b;--red:#d62839;--muted:#59645d;--box:#f7f7f1}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;padding-bottom:88px}
button,input,select,textarea{font:inherit;color:inherit}
.top{background:var(--moss);color:#fff;padding:18px 16px 16px}
.top h1{margin:0;font-size:1.75rem;font-weight:900;letter-spacing:-.02em;line-height:1.05}
.top h1 em{font-style:normal;color:var(--saf)}
.top p{margin:6px 0 0;color:#c9d6c3;font-size:.92rem}
main{max-width:720px;margin:0 auto;padding:14px 12px 0}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin:0 0 12px}
h2.t{font-size:1.2rem;font-weight:900;margin:0 0 10px;padding-left:10px;border-left:6px solid var(--saf);line-height:1.2;letter-spacing:-.01em}
h3.s{font-size:1rem;font-weight:800;margin:14px 0 6px}
.just{text-align:justify;text-justify:inter-word;hyphens:auto;-webkit-hyphens:auto;word-spacing:normal;letter-spacing:normal;margin:0 0 8px;font-size:.95rem;text-wrap:pretty}
.box{background:var(--box);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
.muted{color:var(--muted)}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 10px}
.chip{min-height:40px;border:1.5px solid var(--ink);background:#fff;border-radius:999px;padding:6px 12px;font-weight:700;font-size:.88rem;cursor:pointer}
.chip[aria-pressed=true]{background:var(--ink);color:#fff}
.needs{display:grid;gap:6px}
.need{display:block;text-align:left;width:100%;border:1.5px solid var(--line);background:#fff;border-radius:10px;padding:10px 12px;cursor:pointer}
.need b{display:block;font-size:.98rem}
.need span{display:block;font-size:.84rem;color:var(--muted)}
.need[aria-pressed=true]{border-color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink)}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid var(--saf);outline-offset:2px}
.btn{min-height:44px;border:0;border-radius:10px;padding:10px 16px;font-weight:800;background:var(--ink);color:#fff;cursor:pointer}
.btn.sec{background:#fff;color:var(--ink);border:1.5px solid var(--ink)}
.btn:disabled{opacity:.4;cursor:not-allowed}
.alert{border:2px solid var(--red);background:#fff4f4;color:#5c0f18;border-radius:10px;padding:10px 12px;font-weight:600;font-size:.94rem}
.alert p{margin:0 0 6px}
.info{border:1.5px dashed var(--ink);border-radius:10px;padding:8px 10px;font-size:.9rem;margin:6px 0}
label.ck{display:flex;gap:10px;align-items:flex-start;padding:8px 2px;font-size:.93rem;cursor:pointer}
label.ck input{width:22px;height:22px;flex:none;margin-top:1px;accent-color:var(--ink)}
details.acc{border-top:1px solid var(--line)}
details.acc>summary{list-style:none;cursor:pointer;padding:12px 2px;font-weight:800;display:flex;gap:10px;align-items:center}
details.acc>summary::-webkit-details-marker{display:none}
details.acc>summary::before{content:"+";font-size:1.3rem;line-height:1;width:1.1rem;flex:none}
details.acc[open]>summary::before{content:"\2212"}
details.acc>div{padding:0 2px 12px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.f{display:grid;gap:3px;font-size:.85rem;font-weight:700}
.f input,.f select,.f textarea{width:100%;border:1.5px solid var(--line);border-radius:8px;padding:9px 10px;background:#fff;font-weight:400;font-size:.95rem}
.seg{display:flex;border:1.5px solid var(--ink);border-radius:10px;overflow:hidden}
.seg button{flex:1;min-height:42px;border:0;background:#fff;font-weight:700;font-size:.82rem;cursor:pointer;border-right:1px solid var(--ink)}
.seg button:last-child{border-right:0}
.seg button[aria-pressed=true]{background:var(--ink);color:#fff}
.step{display:flex;align-items:center;gap:6px}
.step button{width:40px;height:40px;border-radius:10px;border:1.5px solid var(--ink);background:#fff;font-weight:900;font-size:1.2rem;cursor:pointer}
.step b{min-width:2.2em;text-align:center}
/* linhas da fórmula */
.row{border:1.5px solid var(--line);border-radius:12px;padding:10px;margin:0 0 10px;background:#fff}
.rh{display:flex;align-items:center;gap:8px}
.rh .nm{flex:1;min-width:0}
.rh .nm b{display:block;line-height:1.15}
.rh .nm i{display:block;font-size:.8rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.role{border:1.5px solid var(--ink);border-radius:8px;padding:5px 4px;font-size:.8rem;font-weight:800;background:#fff;max-width:118px}
.ico{width:36px;height:36px;border-radius:50%;border:1.5px solid var(--line);background:#fff;font-weight:800;cursor:pointer;flex:none}
.sl{display:flex;align-items:center;gap:8px;margin-top:8px}
.pm{width:44px;height:44px;border-radius:12px;border:2px solid var(--ink);background:#fff;font-size:1.4rem;font-weight:900;cursor:pointer;flex:none}
.pm:disabled{opacity:.3;cursor:not-allowed}
input.rg{-webkit-appearance:none;appearance:none;flex:1;min-width:0;height:36px;background:transparent;margin:0;--z:var(--blue)}
input.rg::-webkit-slider-runnable-track{height:14px;border-radius:7px;background:var(--track)}
input.rg::-moz-range-track{height:14px;border-radius:7px;background:var(--track)}
input.rg::-webkit-slider-thumb{-webkit-appearance:none;width:30px;height:30px;border-radius:50%;background:#fff;border:6px solid var(--z);margin-top:-8px;box-shadow:0 1px 4px rgba(0,0,0,.3)}
input.rg::-moz-range-thumb{width:20px;height:20px;border-radius:50%;background:#fff;border:6px solid var(--z);box-shadow:0 1px 4px rgba(0,0,0,.3)}
.z-blue input.rg{--z:var(--blue)}.z-green input.rg{--z:var(--green)}.z-red input.rg{--z:var(--red)}
.rs{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:2px 10px;margin-top:2px}
.val{font-weight:900;font-size:1.15rem}
.z-blue .val,.z-blue .zone{color:var(--blue)}.z-green .val,.z-green .zone{color:var(--green)}.z-red .val,.z-red .zone{color:var(--red)}
.zone{font-weight:800;font-size:.85rem}
.lim{font-size:.8rem;color:var(--muted)}
.lock{margin-top:8px;border:2px solid var(--red);background:#fff4f4;color:#5c0f18;border-radius:10px;padding:8px 10px;font-weight:700;font-size:.9rem}
.pill{display:inline-block;border:1px solid var(--ink);border-radius:999px;padding:1px 8px;font-size:.72rem;font-weight:700;background:#fff}
table{width:100%;border-collapse:collapse;font-size:.88rem}
th,td{padding:6px 4px;border-bottom:1px solid var(--line);text-align:right;vertical-align:top}
th:first-child,td:first-child{text-align:left}
th{font-size:.75rem;color:var(--muted);font-weight:700}
tfoot td{font-weight:900;border-bottom:0}
.gauge{position:relative;height:14px;border-radius:7px;background:linear-gradient(90deg,#c9ccc3,#e9e9e1 50%,#c9ccc3);margin:22px 4px 6px}
.gauge i{position:absolute;top:-6px;width:4px;height:26px;background:var(--ink);border-radius:2px;transform:translateX(-2px)}
.gl{display:flex;justify-content:space-between;font-size:.75rem;color:var(--muted)}
.tags{display:flex;flex-wrap:wrap;gap:5px;margin:4px 0}
.tg{border:1px solid var(--line);background:var(--box);border-radius:6px;padding:2px 7px;font-size:.78rem;font-weight:600}
.chain{display:flex;flex-wrap:wrap;align-items:center;gap:4px;margin:4px 0}
.chain span{border:1.5px solid var(--ink);border-radius:8px;padding:3px 8px;font-size:.8rem;font-weight:700;background:#fff}
.chain span.off{border-color:var(--line);color:#9aa39c;text-decoration:line-through;font-weight:500}
.chain em{font-style:normal;color:var(--muted)}
.mini{position:relative;height:8px;border-radius:4px;background:var(--track);margin:6px 0 2px}
.states{display:flex;align-items:stretch;gap:4px;overflow-x:auto;padding-bottom:4px}
.states div{flex:1;min-width:96px;border:1.5px solid var(--ink);border-radius:10px;padding:8px 6px;text-align:center;font-size:.8rem;background:#fff}
.states b{display:block;font-size:.88rem}
.wbar{height:8px;border-radius:4px;background:var(--line);margin-top:5px;overflow:hidden}
.wbar i{display:block;height:100%;background:var(--ink)}
.tabs{position:fixed;left:0;right:0;bottom:0;display:flex;background:#fff;border-top:1.5px solid var(--ink);padding-bottom:env(safe-area-inset-bottom);z-index:5}
.tabs button{flex:1;min-height:60px;border:0;background:#fff;font-weight:800;font-size:.8rem;cursor:pointer;border-top:4px solid transparent}
.tabs button[aria-selected=true]{border-top-color:var(--saf);background:var(--moss);color:#fff}
.toast{position:fixed;left:50%;bottom:76px;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 16px;border-radius:10px;font-weight:700;font-size:.9rem;z-index:9;max-width:90vw}
@media (min-width:720px){.grid3{grid-template-columns:repeat(3,1fr)}}
</style>
</head>
<body>
<header class="top">
  <h1>Oficina de <em>Fórmulas</em></h1>
  <p>Escolhe a necessidade, ajusta as doses, prepara. Calculadora fitoterápica com limites de segurança.</p>
</header>
<main id="app"></main>
<nav class="tabs" role="tablist" aria-label="Secções">
  <button role="tab" data-tab="f" aria-selected="true">Fórmula</button>
  <button role="tab" data-tab="p" aria-selected="false">Preparar</button>
  <button role="tab" data-tab="l" aria-selected="false">Plantas</button>
  <button role="tab" data-tab="b" aria-selected="false">Biblioteca</button>
</nav>

<script>
'use strict';
/* ============================== UTILITÁRIOS ============================== */
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const fmt=n=>String(Math.round(n*100)/100).replace('.',',');
const toast=m=>{const t=document.createElement('div');t.className='toast';t.setAttribute('role','status');t.textContent=m;document.body.appendChild(t);setTimeout(()=>t.remove(),2600)};

/* ============================== DADOS ============================== */
const AREAS=['Movimentação','Nutrição e digestão','Clareza','Defesa','Harmonização'];
const SRC={V:'EMA (verificada)',F:'Farmacopeia Chinesa (a confirmar)',E:'Referência conservadora (a confirmar)',U:'Definida por ti',N:'Sem dose de referência'};
const COND={liver:'Doença hepática',biliar:'Cálculos ou obstrução biliar',ulcer:'Úlcera ou refluxo',renalcard:'Insuficiência cardíaca ou renal',auto:'Doença autoimune ou imunossupressão',thyroid:'Doença da tiroide',obstr:'Obstrução ou estenose intestinal'};
const ALG={asteraceae:'asteráceas (camomila, arnica)',apiaceae:'apiáceas (funcho, anis)',lamiaceae:'lamiáceas (tomilho, hortelã)',salicylate:'salicilatos ou AINEs'};
const MED={anticoag:'Anticoagulantes ou antiagregantes',aine:'AINEs ou aspirina',antidep:'Antidepressivos',contra:'Contracetivos orais',imuno:'Imunossupressores',sed:'Sedativos, ansiolíticos ou hipnóticos',antidiab:'Antidiabéticos',cardio:'Medicação cardíaca ou anti-hipertensora',diur:'Diuréticos',tirmed:'Medicação da tiroide',outros:'Outra medicação crónica'};
const ALARMS=['Dor forte ou súbita','Febre alta (a partir de 38,5 °C) ou com mais de 3 dias','Sangue nas fezes, na urina ou na expetoração','Dor no peito, falta de ar ou palpitações fortes','Deformação visível, inchaço súbito ou articulação quente e vermelha','Perda de peso sem explicação','Sintomas há mais de 2 semanas','Confusão, desmaio ou fraqueza súbita','Pensamentos de me magoar'];
const FL={'辛':'acre','甘':'doce','酸':'ácido','苦':'amargo','咸':'salgado','淡':'insípido'};
const NAT={'寒':[-2,'frio'],'凉':[-1,'fresco'],'微寒':[-1,'ligeiramente frio'],'平':[0,'neutro'],'微温':[1,'ligeiramente morno'],'温':[1,'morno'],'热':[2,'quente']};
const MODE={pre:['先煎 xiān jiān','cozer primeiro (partes duras)'],co:['同煎 tóng jiān','cozer juntas'],post:['后下 hòu xià','juntar no fim (aromáticas)'],bag:['包煎 bāo jiān','em saquinho de pano (sementes miúdas)']};
const ROLES={C:'君 Chefe',M:'臣 Ministro',A:'佐 Assistente',G:'使 Guia'};
const PZ={crush:'打碎 dǎ suì: partir ou esmagar antes',roast:'炒 chǎo: torrar levemente e partir',slit:'劈开 pī kāi: abrir ao meio'};
const LT={xx:'相须 xiāng xū: reforço mútuo',xs:'相使 xiāng shǐ: assistência',xw:'相畏 xiāng wèi: contenção',xk:'相杀 xiāng shā: neutralização',xe:'相恶 xiāng wù: enfraquecimento (evitar)',xf:'相反 xiāng fǎn: incompatível (evitar)',syn:'Sinergia tradicional',ct:'Cautela (interação)'};

const PL=[];
function P(id,n,l,tr,pt,ar,d,src,mode,f,o){PL.push(Object.assign({id,n,l,tr,pt,ar,d,src,mode,f},o||{}))}
/* id, nome, latim, tradição, partes, áreas, [mín,típ,máx g/dia de erva seca], fonte, modo de decocção, formas (i=infusão d=decocção p=pó m=PMC) */
P('urtiga','Urtiga','Urtica dioica','PT',['folha'],[0],[2,6,12],'E','post','ipm',{cx:['renalcard'],ixw:['diur'],tg:['diur'],ct:'Edemas por insuficiência cardíaca ou renal.',it:'Cautela com diuréticos.',why:'Máx. 12 g/dia = 4 chávenas de 3 g. Mín. 2 g é uma dose de teste. Se a dor persistir mais de 2 semanas, consultar.'});
P('salgueiro','Salgueiro-branco','Salix alba','PT',['casca'],[0],[3,6,12],'V','pre','dpm',{cx:['preg','lact','ulcer'],al:['salicylate'],ixb:['anticoag','aine'],tg:['antiplat'],ct:'Alergia a salicilatos, úlcera gástrica, menores de 18 anos, gravidez e lactação.',it:'Anticoagulantes e anti-inflamatórios não esteroides.',why:'EMA: infusão de 1 a 3 g em 150 ml, 3 a 4 vezes por dia, o que dá o máximo de 12 g/dia. Contém salicilatos.'});
P('gengibre','Gengibre','Zingiber officinale','Out',['rizoma'],[0,1],[1,2,4],'E','co','idpm',{cw:['preg','biliar'],ixw:['anticoag'],tg:['antiplat'],psi:1,tcm:{n:'微温',s:['辛'],m:['Pulmão','Baço','Estômago']},ct:'Cálculos biliares (cautela). Gravidez só com aconselhamento.',it:'Anticoagulantes e antiagregantes (efeito teórico com doses altas).',why:'Faixa prática de 1 a 4 g/dia de rizoma seco. Acima disso aumentam a irritação gástrica e o efeito antiagregante.'});
P('curcuma','Cúrcuma','Curcuma longa','Out',['rizoma'],[0],[1,3,6],'E','co','dpm',{cx:['biliar'],ixw:['anticoag'],tg:['antiplat'],psi:1,tcm:{n:'温',s:['辛','苦'],m:['Baço','Fígado']},ct:'Obstrução biliar, cálculos biliares.',it:'Anticoagulantes e antiagregantes.',why:'Só rizoma inteiro, 1 a 6 g/dia. Extratos concentrados associaram-se a lesão hepática, por isso não são calculados aqui.'});
P('camomila','Camomila','Matricaria recutita','PT',['flor'],[1],[2,6,12],'E','post','ip',{al:['asteraceae'],ixw:['anticoag'],ct:'Alergia a asteráceas.',it:'Cautela com anticoagulantes (dados limitados).',why:'Cerca de 3 g por chávena, até 4 chávenas por dia. Aromática: não fazer PMC, perde os óleos voláteis.'});
P('funcho','Funcho','Foeniculum vulgare','PT',['semente'],[1],[1,3,6],'E','co','ip',{seed:1,al:['apiaceae'],cx:['preg','lact'],psi:1,tcm:{n:'温',s:['辛'],m:['Fígado','Rim','Baço','Estômago']},pz:'crush',ct:'Alergia a apiáceas. Gravidez, lactação e crianças pequenas.',it:'Não documentadas.',why:'Limite baixo por precaução (contém estragole). Esmagar a semente antes.'});
P('chenpi','Chen pi (casca de tangerina)','Citrus reticulata','Out',['casca'],[1],[3,6,10],'F','co','idpm',{psi:1,tcm:{n:'温',s:['苦','辛'],m:['Pulmão','Baço']},ct:'Não documentadas.',it:'Não documentadas.',why:'Farmacopeia Chinesa: 3 a 10 g/dia. A casca envelhecida é a mais valorizada.'});
P('dente','Dente-de-leão','Taraxacum officinale','PT',['raiz','folha'],[1],[2,6,10],'E','co','idpm',{cx:['biliar','obstr'],cw:['ulcer'],al:['asteraceae'],ixw:['diur'],tg:['diur'],tcm:{n:'寒',s:['苦','甘'],m:['Fígado','Estômago']},ct:'Obstrução biliar ou intestinal, alergia a asteráceas. Cautela na úlcera gástrica.',it:'Cautela com diuréticos.',why:'Referência conservadora. Diurético suave: não somar com outras plantas diuréticas.'});
P('alcachofra','Alcachofra','Cynara scolymus','PT',['folha'],[1],[2,6,9],'E','co','idpm',{cx:['biliar'],al:['asteraceae'],ct:'Obstrução biliar, alergia a asteráceas.',it:'Não documentadas.',why:'Referência conservadora para a folha seca em infusão.'});
P('boldo','Boldo','Peumus boldus','Out',['folha'],[1],[1,3,6],'E','post','ip',{cx:['preg','lact','liver','biliar'],ct:'Obstrução biliar, doença hepática grave, gravidez, lactação, menores de 18 anos.',it:'Não documentadas.',why:'Limite baixo por precaução (alcaloides) e uso curto. É digestivo, não protetor do fígado.'});
P('schisandra','Schisandra (wu wei zi)','Schisandra chinensis','Out',['fruto'],[1],[2,3,6],'F','co','dpm',{cx:['preg','ulcer'],ixb:['imuno'],pz:'crush',tcm:{n:'温',s:['酸','甘'],m:['Pulmão','Coração','Rim']},ct:'Gravidez, refluxo ou úlcera com excesso de acidez.',it:'Medicamentos metabolizados pelo CYP3A4 (por exemplo, tacrolimus).',why:'Farmacopeia Chinesa: 2 a 6 g/dia.'});
P('valeriana','Valeriana','Valeriana officinalis','PT',['raiz'],[2],[1,3,9],'V','co','idp',{cx:['preg','lact'],ixw:['sed'],tg:['sed'],ct:'Menores de 12 anos. Gravidez e lactação (dados insuficientes).',it:'Cautela com sedativos e álcool.',why:'EMA: 0,3 a 3 g por toma em infusão, até 3 tomas: máx. 9 g/dia. O efeito é gradual (2 a 4 semanas). Se persistir depois de 2 semanas, consultar.'});
P('cidreira','Erva-cidreira','Melissa officinalis','PT',['folha'],[2],[1.5,4.5,9],'E','post','ip',{cx:['preg','lact'],ixw:['sed'],tg:['sed'],ct:'Menores de 12 anos. Gravidez e lactação (dados insuficientes).',it:'Cautela com sedativos.',why:'Referência conservadora (1,5 a 3 g por chávena). Efeito calmante leve.'});
P('tilia','Tília','Tilia cordata','PT',['flor'],[2],[2,6,10],'E','post','ip',{ct:'Alergia a tília.',it:'Não documentadas.',why:'Referência conservadora para a flor seca.'});
P('ashwa','Ashwagandha','Withania somnifera','Out',['raiz'],[2,4],[1,3,6],'E','co','dpm',{cx:['preg','thyroid','auto','liver'],ixb:['imuno','tirmed'],ixw:['sed','antidiab'],tg:['sed'],ct:'Gravidez, hipertiroidismo, doenças autoimunes. Relatos raros de lesão hepática.',it:'Sedativos, imunossupressores, medicação da tiroide, antidiabéticos.',why:'Sem monografia EMA. Faixa tradicional (ayurvédica) de 1 a 6 g/dia de raiz em pó. Uso em ciclos curtos, com pausas.'});
P('suan','Suan zao ren','Ziziphus jujuba var. spinosa','Out',['semente'],[2],[6,10,15],'F','co','dpm',{seed:1,cx:['preg'],ixw:['sed'],tg:['sed'],pz:'crush',tcm:{n:'平',s:['甘','酸'],m:['Coração','Fígado','Vesícula biliar']},ct:'Gravidez (evitar por precaução).',it:'Cautela com sedativos.',why:'Farmacopeia Chinesa: 10 a 15 g/dia. O mínimo de 6 g é uma dose prudente de início.'});
P('passiflora','Passiflora','Passiflora incarnata','Out',['parte aérea'],[2],[1,4,8],'V','post','ip',{cx:['preg','lact'],ixw:['sed'],tg:['sed'],ct:'Menores de 12 anos. Gravidez e lactação.',it:'Cautela com sedativos.',why:'EMA: 1 a 2 g por chávena, até 4 vezes por dia: máx. 8 g/dia. Se persistir mais de 2 semanas, consultar.'});
P('tomilho','Tomilho','Thymus vulgaris e T. zygis','PT',['sumidade florida'],[3],[1,4,8],'E','post','ip',{al:['lamiaceae'],ct:'Alergia a lamiáceas. Crianças pequenas.',it:'Não documentadas.',why:'Referência conservadora (1 a 2 g por chávena, até 4 vezes).'});
