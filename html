function updateRow(id){
  const r=state.rows.find(x=>x.id===id),p=getP(id),el=$('#row-'+id);if(!r||!el)return;
  const c=capOf(p),z=zoneOf(p,r.dose);
  el.className='row z-'+z;$('.val',el).textContent=fmt(r.dose)+' g/dia';$('.zone',el).textContent=zoneTxt[z];
  $('input.rg',el).value=r.dose;$('[data-a=inc]',el).disabled=r.dose>=c-1e-9;$('[data-a=dec]',el).disabled=r.dose<=0;
  updateResults();
}
function calc(){
  const F=state.form,out=[];let tot=0,totRaw=0;
  const wt=state.tabW*state.frac/100;
  activeRows().forEach(r=>{
    const p=getP(r.id);let v=null,unit='g';
    if(F==='inf'&&(has(p,'i')||has(p,'d'))) v=r.dose;
    else if(F==='po'&&has(p,'p')) v=r.dose;
    else if(F==='pmc'&&has(p,'m')) v=r.dose/state.ratio;
    else if(F==='cp'){ if(has(p,'m')) {v=r.dose/state.ratio/wt;unit='cp'} else if(has(p,'p')){v=r.dose/wt;unit='cp'} }
    out.push({p,raw:r.dose,v,unit});if(v!=null)tot+=v;totRaw+=r.dose;
  });
  return {out,tot,totRaw};
}
function updateResults(){
  const el=$('#res');if(!el)return;
  const {out,tot,totRaw}=calc(),F=state.form,d=state.dias,t=state.tomas;
  if(!out.length){el.innerHTML='<h2 class="t">4 · Resultado</h2><p class="just">Adiciona ou ajusta plantas para ver o resultado.</p>';return}
  const u=F==='cp'?'cp':'g';
  const rows=out.map(o=>`<tr><td>${esc(o.p.n)}</td><td>${fmt(o.raw)}</td><td>${o.v==null?'<span class="muted">não se aplica</span>':fmt(o.v)+' '+u}</td><td>${o.v==null?'—':fmt(o.v*d)+' '+u}</td></tr>`).join('');
  const na=out.filter(o=>o.v==null).map(o=>o.p.n);
  const ha=activeRows();
  const grp={};ha.forEach(r=>(getP(r.id).tg||[]).forEach(g=>(grp[g]=grp[g]||[]).push(getP(r.id).n)));
  const GM={sed:'Somam efeito sedativo',antiplat:'Somam efeito antiagregante',diur:'Somam efeito diurético',muc:'Mucilagens: tomar 1 hora afastadas de outros medicamentos e com muita água'};
  const al=Object.keys(grp).filter(g=>(g==='muc'?grp[g].length>=1:grp[g].length>=2)).map(g=>`<div class="info"><b>${GM[g]}:</b> ${esc(grp[g].join(', '))}.${g==='sed'?' Reduz cada dose e evita conduzir.':''}</div>`).join('');
  /* papéis */
  let pap='';const ch=state.rows.filter(r=>r.role==='C'&&activeRows().includes(r));
  if(!ch.length) pap='<div class="info">Falta um Chefe (君): a planta principal da fórmula.</div>';
  else{const rel=r=>r.dose/getP(r.id).d[1];const mx=Math.max(...ha.map(rel));if(rel(ch[0])<mx-0.25) pap='<div class="info">O Chefe (君) devia ter o maior peso relativo. Revê as doses ou os papéis.</div>'}
  /* MTC */
  const tc=ha.filter(r=>getP(r.id).tcm);let g='';
  if(tc.length){const s=tc.reduce((a,r)=>a+NAT[getP(r.id).tcm.n][0]*r.dose,0)/tc.reduce((a,r)=>a+r.dose,0);
   const pos=(s+2)/4*100,pr=state.prof.tend,msg=(pr==='calor'&&s>0.4)?'A fórmula tende a quente e a tendência indicada é de calor: reduz as plantas mornas ou junta frescas.':(pr==='frio'&&s<-0.4)?'A fórmula tende a fria e a tendência indicada é de frio: reduz as plantas frias.':'Equilíbrio térmico compatível com a tendência indicada.';
   const fl={};tc.forEach(r=>getP(r.id).tcm.s.forEach(x=>fl[x]=(fl[x]||0)+r.dose));
   const mer={};tc.forEach(r=>getP(r.id).tcm.m.forEach(x=>mer[x]=(mer[x]||0)+r.dose));
   g=`<h3 class="s">Balanço em MTC (${tc.length} de ${ha.length} plantas classificadas)</h3><div class="gauge"><i style="left:${pos}%"></i></div><div class="gl"><span>frio 寒</span><span>neutro 平</span><span>quente 热</span></div><p class="just">${msg}</p>
   <div class="tags">${Object.entries(fl).sort((a,b)=>b[1]-a[1]).map(([k])=>`<span class="tg">${k} ${FL[k]}</span>`).join('')}</div>
   <div class="tags">${Object.entries(mer).sort((a,b)=>b[1]-a[1]).map(([k])=>`<span class="tg">${k}</span>`).join('')}</div>`}
  /* ligações */
  const ids=ha.map(r=>r.id);const lk=state.links.filter(l=>ids.includes(l.a)&&ids.includes(l.b)).map(l=>`<div class="${['xe','xf','ct'].includes(l.t)?'info':'box just'}"><b>${esc(getP(l.a).n)} + ${esc(getP(l.b).n)}</b> · ${LT[l.t]}<br>${esc(l.n)}${l.fonte?' ('+esc(l.fonte)+')':''}</div>`).join('');
  const perToma=tot/t;
  el.innerHTML=`<h2 class="t">4 · Resultado</h2>
   <table><thead><tr><th>Planta</th><th>g/dia crua</th><th>${F==='cp'?'Comprimidos/dia':'Por dia'}</th><th>Lote ${d} d</th></tr></thead><tbody>${rows}</tbody>
   <tfoot><tr><td>Total</td><td>${fmt(totRaw)}</td><td>${fmt(tot)} ${u}</td><td>${fmt(tot*d)} ${u}</td></tr></tfoot></table>
   <p class="just" style="margin-top:8px">${t} tomas por dia: <b>${fmt(perToma)} ${u==='cp'?'comprimidos':'g'}</b> por toma.${F==='pmc'?` Razão do PMC ${fmt(state.ratio)}:1 (1 g de PMC ≈ ${fmt(state.ratio)} g de erva crua).`:''}</p>
   ${na.length?`<div class="info">Sem esta forma: ${esc(na.join(', '))}. ${F==='pmc'||F==='cp'?'Aromáticas perdem óleos voláteis no PMC e mucilagens formam gel.':''}</div>`:''}
   ${al}${pap}${lk}${g}
   <div class="grid2" style="margin-top:12px"><button class="btn sec" data-a="copy">Copiar resumo</button><button class="btn" data-a="goprep">Preparar lote</button></div>`;
}
function summaryText(){
  const n=NEEDS.find(x=>x.id===state.need),{out,tot}=calc();
  return `Fórmula: ${n?n.n:'—'}\nForma: ${state.form}; ${state.tomas} tomas/dia; lote de ${state.dias} dias\n`+out.map(o=>`- ${o.p.n}: ${fmt(o.raw)} g/dia crua`+(o.v!=null?` (${fmt(o.v)} ${o.unit==='cp'?'cp':'g'}/dia na forma)`:'')).join('\n')+`\nTotal na forma: ${fmt(tot)}/dia`;
}

/* ============================== PREPARAR ============================== */
function tabPrep(){
  const {out}=calc();const lot=out.reduce((a,o)=>a+o.raw,0)*state.dias;
  const herb=state.prep.herb==null?(lot||100):state.prep.herb;
  const y=state.prep.yield/100,ratio=y>0?1/y:0;
  const w1=herb*10,w2=herb*8,dry=herb*y,soft=dry/0.7,tabs=dry/(state.tabW*state.frac/100);
  const act=activeRows().map(r=>getP(r.id));
  const grp=m=>act.filter(p=>p.mode===m).map(p=>p.n).join(', ')||'—';
  const pz=act.filter(p=>p.pz).map(p=>p.n+' ('+PZ[p.pz]+')').join('; ')||'—';
  const st=[
   ['Do chá ao comprimido',`<div class="states">
     ${[['Chá','≈ 98%',98],['Xarope','≈ 70%',70],['Pasta','20–30%',25],['Pó (PMC)','< 5%',4],['Comprimido','< 5%',4]].map(([a,b,c])=>`<div><b>${a}</b>água ${b}<div class="wbar"><i style="width:${c}%"></i></div></div>`).join('')}</div>
     <p class="just" style="margin-top:8px">O chá é água com 1 a 3% de sólidos dissolvidos: açúcares, mucilagens, saponinas, taninos e outros compostos solúveis. Ao evaporar a água, os sólidos ficam e concentram-se. Como as gomas e mucilagens engrossam o líquido, ele passa a xarope, depois a pasta (extrato mole) e, seco, a vidro quebradiço que se mói em pó. É essa a essência: a erva sem a fibra.</p>
     <p class="just">O pó é higroscópico e não se prende sozinho. Para virar comprimido duro, junta-se um ligante, granula-se, seca-se e prensa-se (passos 10 e 11).</p>`],
   ['1 · Preparar a matéria-prima (炮制 páozhì)',`<p class="just">Pesar a erva seca. Preparações da fórmula atual: ${esc(pz)}. Sementes duras partem-se para largarem os princípios; as gordas moem-se só no fim.</p>`],
   ['2 · Molho (浸泡 jìnpào)',`<p class="just">Cobrir com água fria, 30 minutos (raízes, cascas e sementes até 60). A erva absorve água e abre-se, e a extração é mais completa e mais suave.</p>`],
   ['3 · 1.ª decocção (头煎 tóujiān)',`<p class="just">Água: <b>${fmt(w1)} ml</b> (10 ml por g). Lume forte até ferver e depois brando (文火 wénhuǒ), tapado, cerca de 25 minutos. 先煎 (cozer primeiro, mais 15 a 30 min): ${esc(grp('pre'))}. 后下 (juntar nos últimos 5 a 10 min): ${esc(grp('post'))}. 包煎 (saquinho): ${esc(grp('bag'))}.</p>`],
   ['4 · Coar',`<p class="just">Coar por pano de algodão ou musselina e espremer o bagaço. Guardar o líquido num jarro de vidro.</p>`],
   ['5 · 2.ª decocção (二煎 èrjiān)',`<p class="just">Voltar a cozer o bagaço com <b>${fmt(w2)} ml</b> de água durante 20 minutos e coar. Junta-se à 1.ª: a primeira água satura-se e não leva tudo. Trabalhar em lote, sem guardar o líquido mais de 24 a 48 horas no frio.</p>`],
   ['6 · Concentrar até à pasta',`<p class="just">Lume mínimo, tacho largo e aberto, sem ferver com força (acima de cerca de 90 °C degrada). Mexer com colher de madeira. Quando restar pouco, passar a banho-maria. Ponto: escorre devagar como mel espesso e a colher deixa sulco. Massa final esperada: cerca de <b>${fmt(soft)} g</b> de pasta.</p>`],
   ['7 · Secar',`<p class="just">Espalhar a pasta em camada de 2 a 3 mm sobre silicone ou papel vegetal, em desidratador a 45 a 55 °C durante 8 a 16 horas, até quebrar como vidro. Se ainda vergar, não está seco.</p>`],
   ['8 · Moer, peneirar e pesar',`<p class="just">Moer, peneirar e pesar o pó. Rendimento esperado de <b>${fmt(dry)} g</b> (${state.prep.yield}%). Se juntares 10 a 20% de farinha de arroz para não empedrar, anota-o. <b>A razão real é o teu peso de erva a dividir pelo peso de pó: 1 g de PMC vale ${fmt(ratio)} g de erva.</b></p>`],
   ['9 · Guardar',`<p class="just">Frasco âmbar de vidro com tampa hermética e sílica alimentar. Etiqueta: fórmula, data, lote, razão. Fora da luz e do calor.</p>`],
   ['10 · Pílula de mel (蜜丸 mì wán)',`<p class="just">Aquecer o mel até 116 a 118 °C (中蜜) e misturar com o pó morno, na proporção de 1 parte de pó para 1 a 1,5 de mel, até formar uma massa. Enrolar bolas de peso igual e secar ao ar. Duram menos que os comprimidos.</p>`],
   ['11 · Comprimido duro',`<p class="just">Mistura: 60 a 75% de PMC, 20 a 30% de celulose microcristalina, 3 a 5% de amido, 0,5 a 1% de estearato de magnésio. Humedecer com um pouco de água ou álcool a 60% até formar bola que se desfaz, passar por peneira de 1,4 mm, secar a 40 a 50 °C até 3 a 5% de humidade, peneirar e juntar o lubrificante. Prensar em prensa manual de comprimidos. Objetivo: <b>${fmt(tabs)}</b> comprimidos de ${fmt(state.tabW)} g (${state.frac}% de ativo) neste lote. Testes: cair de 50 cm sem partir, desagregar em água morna em menos de 30 minutos, e pesar 20 comprimidos: nenhum a mais de ±5% do peso médio (±7,5% se pesarem menos de 250 mg).</p>`]
  ];
  return `<section class="card"><h2 class="t">Preparar o lote</h2>
   <div class="grid3">
    <label class="f">Erva do lote (g)<input type="number" inputmode="decimal" min="1" step="1" data-i="herb" value="${Math.round(herb*10)/10}"></label>
    <label class="f">Rendimento medido (%)<input type="number" inputmode="decimal" min="3" max="60" step="0.5" data-i="yield" value="${state.prep.yield}"></label>
    <label class="f">Comprimido (g)<input type="number" inputmode="decimal" min="0.1" step="0.05" data-i="tabW" value="${state.tabW}"></label>
   </div>
   <p class="just" style="margin-top:8px">Razão de concentração: <b>${fmt(ratio)}:1</b>. Pesa a erva e o pó de cada lote e escreve aqui o rendimento real; o cálculo do PMC na Fórmula passa a usá-lo.</p>
   <button class="btn sec" data-a="useratio">Usar esta razão na Fórmula</button></section>
  <section class="card">${st.map(([t,h],i)=>`<details class="acc" ${i===0?'open':''}><summary>${esc(t)}</summary><div>${h}</div></details>`).join('')}</section>
  <section class="card"><h2 class="t">Frascos e recipientes</h2>${VESSELS.map(v=>`<details class="acc"><summary>${esc(v[0])}</summary><div><p class="just"><b>${esc(v[1])}.</b></p><p class="just muted">${esc(v[2])}</p></div></details>`).join('')}</section>`;
}

/* ============================== PLANTAS ============================== */
function chainHTML(p){
  return p.pt.map(pt=>{
    const it=[`${pt} crua`];
    if(p.pz) it.push(PZ[p.pz].split(':')[0]);
    it.push(`pó de ${pt}`);
    it.push(has(p,'m')?`PMC de ${pt}`:'PMC');
    it.push(p.psi?`PSI de ${pt}`:'PSI');
    it.push('comprimido');
    return `<div class="chain">${it.map((x,i)=>{const off=(x==='PMC'||x==='PSI')||(x==='comprimido'&&!has(p,'m')&&!has(p,'p'))||(x.startsWith('pó de')&&!has(p,'p')&&!has(p,'m'));return (i?'<em>→</em>':'')+`<span class="${off?'off':''}">${esc(x)}</span>`}).join('')}</div>`}).join('')+
   (p.oil?'<p class="just muted">Oleaginosa: moer na hora e guardar no frio, no máximo 2 semanas.</p>':'')+(p.muc?'<p class="just muted">Mucilaginosa: forma gel com água. Sem PMC.</p>':'')+(has(p,'i')&&!has(p,'m')&&!p.seed&&p.d?'<p class="just muted">Aromática ou mucilaginosa: o PMC perde óleos voláteis.</p>':'');
}
function plantCard(p){
  const lk=state.links.filter(l=>l.a===p.id||l.b===p.id).map(l=>{const o=getP(l.a===p.id?l.b:l.a);return `<div class="box just"><b>${esc(o?o.n:'?')}</b> · ${LT[l.t]}<br>${esc(l.n)}${l.fonte?' ('+esc(l.fonte)+')':''}</div>`}).join('');
  const bar=p.d?`<div class="mini" style="--track:linear-gradient(90deg,var(--blue) 0 ${p.d[0]/p.d[2]*100}%,var(--green) ${p.d[0]/p.d[2]*100}% 96%,var(--red) 96% 100%)"></div><div class="lim">${fmt(p.d[0])} a ${fmt(p.d[2])} g/dia</div>`:`<div class="lim">${esc(SRC.N)}</div>`;
  const t=p.tcm?`<div class="tags"><span class="tg">${p.tcm.n} ${NAT[p.tcm.n][1]}</span>${p.tcm.s.map(x=>`<span class="tg">${x} ${FL[x]}</span>`).join('')}${p.tcm.m.map(x=>`<span class="tg">${x}</span>`).join('')}${p.mode&&MODE[p.mode]?`<span class="tg">${MODE[p.mode][0]}</span>`:''}</div>`:'';
  return `<details class="acc"><summary><span style="flex:1"><b>${esc(p.n)}</b> <span class="muted">${esc(p.l)}</span></span><span class="pill">${p.tr==='PT'?'Portugal':'Outras'}</span></summary><div>
   ${bar}<p class="lim">${esc(SRC[p.src])}</p>${t}
   <h3 class="s">Cadeia por parte</h3>${chainHTML(p)}
   <p class="just"><b>Contraindicações:</b> ${esc(p.ct||'—')}<br><b>Interações:</b> ${esc(p.it||'—')}</p>
   <p class="just">${esc(p.why||'')}</p>${lk?'<h3 class="s">Ligações</h3>'+lk:''}
   <label class="f" style="margin-top:8px">A tua nota e fonte<textarea rows="3" data-i="note" data-id="${p.id}" placeholder="Conhecimento teu, com fonte">${esc(state.notes[p.id]||'')}</textarea></label>
   ${p.d?`<details class="acc"><summary>Editar limites (com justificação)</summary><div><div class="grid3"><label class="f">Mín. g<input type="number" step="0.1" data-lim="0" data-id="${p.id}" value="${p.d[0]}"></label><label class="f">Típ. g<input type="number" step="0.1" data-lim="1" data-id="${p.id}" value="${p.d[1]}"></label><label class="f">Máx. g<input type="number" step="0.1" data-lim="2" data-id="${p.id}" value="${p.d[2]}"></label></div>
   <label class="f">Justificação<textarea rows="2" data-lim="why" data-id="${p.id}"></textarea></label><label class="f">Fonte<input data-lim="fonte" data-id="${p.id}"></label>
   <button class="btn sec" data-a="savelim" data-v="${p.id}" style="margin-top:8px">Guardar limites</button></div></details>`:''}
  </div></details>`;
}
function listPlants(){
  const q=state.lib.q.toLowerCase(),a=state.lib.area,pt=state.lib.part;
  const L=allP().filter(p=>(!q||(p.n+' '+p.l).toLowerCase().includes(q))&&(a<0||p.ar.includes(a))&&(!pt||p.pt.includes(pt)));
  return L.length?L.map(plantCard).join(''):'<p class="just">Nenhuma planta encontrada.</p>';
}
function tabLib(){
  const parts=[...new Set(allP().flatMap(p=>p.pt))].sort();
  return `<section class="card"><h2 class="t">Plantas</h2>
   <label class="f">Procurar<input type="search" data-i="q" value="${esc(state.lib.q)}" placeholder="Nome comum ou científico"></label>
   <div class="chips" style="margin-top:8px"><button class="chip" data-a="larea" data-v="-1" aria-pressed="${state.lib.area<0}">Todas</button>${AREAS.map((a,i)=>`<button class="chip" data-a="larea" data-v="${i}" aria-pressed="${state.lib.area===i}">${a}</button>`).join('')}</div>
   <label class="f">Parte<select data-i="part"><option value="">Todas</option>${parts.map(x=>`<option ${state.lib.part===x?'selected':''}>${esc(x)}</option>`).join('')}</select></label>
   <div id="plist" style="margin-top:8px">${listPlants()}</div></section>`;
}

/* ============================== BIBLIOTECA ============================== */
function tabBib(){
  const all=allP().slice().sort((a,b)=>a.n.localeCompare(b.n,'pt'));
  const opt=all.map(p=>`<option value="${p.id}">${esc(p.n)}</option>`).join('');
  return `<section class="card"><h2 class="t">Adicionar planta</h2>
   <p class="just">Só entra com justificação e fonte. Os limites que definires ficam marcados como teus.</p>
   <div class="grid2"><label class="f">Nome<input id="np-n"></label><label class="f">Nome científico<input id="np-l"></label>
   <label class="f">Parte<select id="np-pt"><option>semente</option><option>raiz</option><option>folha</option><option>flor</option><option>casca</option><option>fruto</option><option>rizoma</option><option>resina</option></select></label>
   <label class="f">Origem<select id="np-tr"><option value="PT">Portugal</option><option value="Out">Outras</option></select></label>
   <label class="f">Área<select id="np-ar">${AREAS.map((a,i)=>`<option value="${i}">${esc(a)}</option>`).join('')}</select></label>
   <label class="f">Cozedura<select id="np-mo"><option value="co">同煎 juntas</option><option value="pre">先煎 primeiro</option><option value="post">后下 no fim</option><option value="bag">包煎 saquinho</option></select></label></div>
   <div class="grid3" style="margin-top:8px"><label class="f">Mín. g/dia<input id="np-a" type="number" step="0.1"></label><label class="f">Típ. g/dia<input id="np-b" type="number" step="0.1"></label><label class="f">Máx. g/dia<input id="np-c" type="number" step="0.1"></label></div>
   <label class="f">Justificação dos limites<textarea id="np-w" rows="2"></textarea></label>
   <label class="f">Fonte<input id="np-s"></label>
   <label class="ck"><input type="checkbox" id="np-f1" checked><span>Faz chá ou decocção</span></label><label class="ck"><input type="checkbox" id="np-f2" checked><span>Faz pó</span></label><label class="ck"><input type="checkbox" id="np-f3"><span>Faz PMC</span></label>
   <button class="btn" data-a="addp">Guardar planta</button></section>
  <section class="card"><h2 class="t">Ligar conhecimento</h2>
   <div class="grid2"><label class="f">Planta A<select id="lk-a">${opt}</select></label><label class="f">Planta B<select id="lk-b">${opt}</select></label></div>
   <label class="f">Tipo<select id="lk-t">${Object.keys(LT).map(k=>`<option value="${k}">${esc(LT[k])}</option>`).join('')}</select></label>
   <label class="f">Nota<textarea id="lk-n" rows="2"></textarea></label><label class="f">Fonte<input id="lk-f"></label>
   <button class="btn" data-a="addlink">Guardar ligação</button></section>
  <section class="card"><h2 class="t">Guardar e carregar</h2>
   <p class="just">Este ficheiro não guarda dados sozinho. Descarrega o teu conhecimento e volta a carregá-lo quando quiseres.</p>
   <div class="grid2"><button class="btn" data-a="export">Descarregar</button><label class="btn sec" style="display:flex;align-items:center;justify-content:center;text-align:center">Carregar<input type="file" accept="application/json" data-i="import" hidden></label></div></section>`;
}

/* ============================== RENDER E EVENTOS ============================== */
function render(){
  const a=$('#app');
  a.innerHTML=state.tab==='f'?tabF():state.tab==='p'?tabPrep():state.tab==='l'?tabLib():tabBib();
  $$('.tabs button').forEach(b=>b.setAttribute('aria-selected',b.dataset.tab===state.tab));
  if(state.tab==='f') updateResults();
}
function tabF(){
  const needs=NEEDS.filter(n=>n.ar===state.area),nd=NEEDS.find(n=>n.id===state.need);
  return `<section class="card"><h2 class="t">1 · Necessidade</h2>
   <p class="just muted">Sintomas ligeiros e passageiros. Para doença, dor forte ou deformação visível, procura um médico.</p>
   <div class="chips">${AREAS.map((a,i)=>`<button class="chip" data-a="area" data-v="${i}" aria-pressed="${state.area===i}">${a}</button>`).join('')}</div>
   <div class="needs">${needs.map(n=>`<button class="need" data-a="need" data-v="${n.id}" aria-pressed="${state.need===n.id}"><b>${n.n}</b><span>${n.s}</span></button>`).join('')}</div>
   ${nd&&nd.ar===state.area?`<p class="just box" style="margin-top:8px">${esc(nd.why)}</p>`:''}</section>
  ${safetyCard()}
  ${state.need&&state.ok&&!alarmOn()?formulaCard():(state.need&&!alarmOn()?'<div class="info">Confirma o teu perfil para ver a fórmula.</div>':'')}`;
}
const act={
 area:b=>{state.area=+b.dataset.v;render()},
 need:b=>{loadNeed(b.dataset.v);render()},
 ok:()=>{state.ok=true;render();toast('Perfil confirmado')},
 form:b=>{state.form=b.dataset.v;render()},
 tomas:b=>{state.tomas=Math.min(4,Math.max(1,state.tomas+ +b.dataset.v));$('#tomas').textContent=state.tomas;updateResults()},
 dias:b=>{state.dias=Math.min(30,Math.max(1,state.dias+ +b.dataset.v));$('#dias').textContent=state.dias;updateResults()},
 rm:b=>{state.rows=state.rows.filter(r=>r.id!==b.dataset.v);render()},
 info:b=>{const e=$('#why-'+b.dataset.v);if(e)e.hidden=!e.hidden},
 dec:b=>nudge(b.dataset.v,-1),inc:b=>nudge(b.dataset.v,1),
 copy:()=>{const t=summaryText();(navigator.clipboard?navigator.clipboard.writeText(t):Promise.reject()).then(()=>toast('Resumo copiado'),()=>toast('Não foi possível copiar'))},
 goprep:()=>{state.tab='p';render();scrollTo(0,0)},
 useratio:()=>{const y=state.prep.yield/100;if(y>0){state.ratio=Math.round(1/y*100)/100;toast('Razão '+fmt(state.ratio)+':1 guardada')}},
 larea:b=>{state.lib.area=+b.dataset.v;render()},
 savelim:b=>{
  const id=b.dataset.v,g=k=>$(`[data-lim="${k}"][data-id="${id}"]`);
  const d=[0,1,2].map(i=>parseFloat(g(i).value)),why=g('why').value.trim(),fonte=g('fonte').value.trim();
  if(d.some(x=>!(x>0))||d[0]>d[1]||d[1]>d[2]) return toast('Limites inválidos: 0 < mín ≤ típ ≤ máx');
  if(!why||!fonte) return toast('A justificação e a fonte são obrigatórias');
  state.ov[id]={d,why,fonte};state.rows.forEach(r=>{if(r.id===id){const p=getP(id);r.dose=Math.min(Math.max(r.dose,p.d[0]),capOf(p))}});render();toast('Limites guardados como teus')},
 addp:()=>{
  const v=id=>$('#'+id).value.trim(),n=v('np-n'),l=v('np-l'),d=[+v('np-a'),+v('np-b'),+v('np-c')],w=v('np-w'),s=v('np-s');
  if(!n) return toast('Falta o nome');
  if(d.some(x=>!(x>0))||d[0]>d[1]||d[1]>d[2]) return toast('Limites inválidos: 0 < mín ≤ típ ≤ máx');
  if(!w||!s) return toast('A justificação e a fonte são obrigatórias');
  const f=($('#np-f1').checked?'id':'')+($('#np-f2').checked?'p':'')+($('#np-f3').checked?'m':'');
  const id='u'+Date.now();
  state.custom.push({id,n,l,tr:$('#np-tr').value,pt:[$('#np-pt').value],ar:[+$('#np-ar').value],d,src:'U',mode:$('#np-mo').value,f,why:w,fonte:s,ct:'Definir na tua nota.',it:'Definir na tua nota.',seed:$('#np-pt').value==='semente'?1:0});
  render();toast('Planta guardada')},
 addlink:()=>{const a=$('#lk-a').value,b=$('#lk-b').value,n=$('#lk-n').value.trim();
  if(a===b) return toast('Escolhe duas plantas diferentes');
  if(!n) return toast('Falta a nota');
  state.links.push({a,b,t:$('#lk-t').value,n,fonte:$('#lk-f').value.trim()});render();toast('Ligação guardada')},
 export:()=>{const j=JSON.stringify({custom:state.custom,ov:state.ov,links:state.links,notes:state.notes,ratio:state.ratio},null,1);
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([j],{type:'application/json'}));a.download='oficina-conhecimento.json';document.body.appendChild(a);a.click();a.remove();toast('Ficheiro descarregado')}
};
function nudge(id,dir){
  const r=state.rows.find(x=>x.id===id),p=getP(id);if(!r)return;
  r.dose=Math.round(Math.min(capOf(p),Math.max(0,r.dose+dir*stepOf(p)))*100)/100;updateRow(id);
}
document.addEventListener('click',e=>{
  const t=e.target.closest('.tabs button');if(t){state.tab=t.dataset.tab;render();scrollTo(0,0);return}
  const b=e.target.closest('[data-a]');if(b&&act[b.dataset.a]) act[b.dataset.a](b);
});
document.addEventListener('input',e=>{
  const el=e.target,i=el.dataset.i;
  if(i==='dose'){const r=state.rows.find(x=>x.id===el.dataset.id),p=getP(el.dataset.id);r.dose=Math.min(capOf(p),+el.value);updateRow(el.dataset.id)}
  else if(i==='q'){state.lib.q=el.value;$('#plist').innerHTML=listPlants()}
  else if(i==='note'){state.notes[el.dataset.id]=el.value}
});
document.addEventListener('change',e=>{
  const el=e.target,i=el.dataset.i,v=el.dataset.v;
  if(!i) return;
  const pr=state.prof,tg=(arr)=>{const k=arr.indexOf(v);k>=0?arr.splice(k,1):arr.push(v)};
  if(i==='alarm'){tg(state.alarm);state.ok=false;render()}
  else if(i==='age'){pr.age=el.value;state.ok=false;render()}
  else if(i==='tend'){pr.tend=el.value;updateResults()}
  else if(i==='frail'){pr.frail=el.checked;state.ok=false;refreshRows()}
  else if(i==='preg'||i==='lact'){pr[i]=el.checked;state.ok=false;refreshRows()}
  else if(['cond','al','med'].includes(i)){tg(pr[i]);state.ok=false;refreshRows()}
  else if(i==='role'){state.rows.find(r=>r.id===el.dataset.id).role=el.value;updateResults()}
  else if(i==='addp'&&el.value){const p=getP(el.value);state.rows.push({id:p.id,role:'A',dose:p.d[0]});render()}
  else if(i==='part'){state.lib.part=el.value;$('#plist').innerHTML=listPlants()}
  else if(i==='herb'){state.prep.herb=Math.max(1,+el.value||1);render()}
  else if(i==='yield'){state.prep.yield=Math.min(60,Math.max(3,+el.value||20));render()}
  else if(i==='tabW'){state.tabW=Math.max(0.1,+el.value||0.5);render()}
  else if(i==='import'){const f=el.files[0];if(!f)return;const rd=new FileReader();rd.onload=()=>{try{const j=JSON.parse(rd.result);
    state.custom=Array.isArray(j.custom)?j.custom:[];state.ov=j.ov||{};state.links=Array.isArray(j.links)?j.links:state.links;state.notes=j.notes||{};if(j.ratio>0)state.ratio=j.ratio;render();toast('Conhecimento carregado')}catch(x){toast('Ficheiro inválido')}};rd.readAsText(f)}
});
function refreshRows(){
  /* reavalia bloqueios: remove linhas bloqueadas do cálculo mas mantém-nas visíveis */
  state.rows.forEach(r=>{const p=getP(r.id);if(p&&p.d){const c=capOf(p);if(r.dose>c)r.dose=c}});
  render();
}
render();
</script>
</body>
</html>
