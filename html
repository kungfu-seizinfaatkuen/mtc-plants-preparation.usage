const getP=id=>{const b=PL.find(p=>p.id===id)||state.custom.find(p=>p.id===id);if(!b)return null;const o=state.ov[id];return o?Object.assign({},b,{d:o.d,why:o.why,src:'U',fonte:o.fonte}):b};
const allP=()=>PL.concat(state.custom).map(p=>getP(p.id));
const capOf=p=>Math.round(p.d[2]*(state.prof.frail?0.75:1)*100)/100;
const stepOf=p=>p.d[2]<=3?0.1:0.5;
const has=(p,c)=>(p.f||'').includes(c);
function blocks(p){
  const r=[],pr=state.prof;
  if(!p.d) return ['sem dose de referência'];
  const cx=p.cx||[];
  if(cx.includes('preg')&&pr.preg) r.push('gravidez');
  if(cx.includes('lact')&&pr.lact) r.push('lactação');
  cx.forEach(c=>{if(COND[c]&&pr.cond.includes(c)) r.push(COND[c].toLowerCase())});
  (p.al||[]).forEach(a=>{if(pr.al.includes(a)) r.push('alergia a '+ALG[a])});
  (p.ixb||[]).forEach(m=>{if(pr.med.includes(m)) r.push('interação com '+MED[m].toLowerCase())});
  return r;
}
function warns(p){
  const r=[],pr=state.prof;
  (p.cw||[]).forEach(c=>{if(c==='preg'&&pr.preg) r.push('gravidez: só com aconselhamento');else if(c==='lact'&&pr.lact) r.push('lactação');else if(COND[c]&&pr.cond.includes(c)) r.push(COND[c].toLowerCase()+': cautela')});
  (p.ixw||[]).forEach(m=>{if(pr.med.includes(m)) r.push('cautela com '+MED[m].toLowerCase())});
  return r;
}
const zoneOf=(p,d)=>{const c=capOf(p);return d>=c-1e-9?'red':(d>=p.d[0]-1e-9?'green':'blue')};
const zoneTxt={blue:'abaixo do mínimo (neutro)',green:'faixa eficaz e equilibrada',red:'máximo atingido: não aumentar'};
const trackOf=p=>{const c=capOf(p),a=Math.min(100,p.d[0]/c*100);return `linear-gradient(90deg,var(--blue) 0 ${a}%,var(--green) ${a}% 96%,var(--red) 96% 100%)`};
const activeRows=()=>state.rows.filter(r=>{const p=getP(r.id);return p&&p.d&&!blocks(p).length&&r.dose>0});
const alarmOn=()=>state.alarm.length>0||state.prof.age!=='adulto';

function loadNeed(id){
  const n=NEEDS.find(x=>x.id===id);state.need=id;state.rows=[];const cut=[];
  n.f.forEach(([pid,role,dose])=>{const p=getP(pid);const b=blocks(p);if(b.length){cut.push(p.n+' ('+b.join(', ')+')');return}
    const c=capOf(p);state.rows.push({id:pid,role,dose:Math.min(Math.max(dose,p.d[0]),c)})});
  state.msg=cut.length?'Retiradas por segurança: '+cut.join('; ')+'.':'';
}

